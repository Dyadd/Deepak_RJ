---
import ViewTracker from '../components/ViewTracker.astro';

interface Props {
  title: string;
  description?: string;
  /** Home page: no nav, no footer links — just the content. */
  bare?: boolean;
  /** Content column the nav and footer align to. */
  width?: 'narrow' | 'wide';
}

const {
  title,
  description = "Writing on medical AI and the mind",
  bare = false,
  width = 'narrow',
} = Astro.props;
const base = import.meta.env.BASE_URL;

const here = Astro.url.pathname.replace(/\/?$/, '/');
const navLinks = [
  { label: 'Writing', href: `${base}writing/` },
  { label: 'Work', href: `${base}work/` },
];

const umamiWebsiteId = '859aec8b-0917-4835-8813-9e7cb9d8d1ae';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={width === 'wide' ? '--content-width: var(--max-width-wide)' : undefined}>
    {!bare && (
      <nav class="nav">
        <div class="nav-inner">
          <a href={base} class="nav-brand">Deepak RJ</a>
          <div class="nav-links">
            {navLinks.map(link => (
              <a
                href={link.href}
                class="nav-link"
                aria-current={here === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}

    <slot />

    <footer class="footer">
      <div class="footer-inner">&copy; {new Date().getFullYear()} Deepak RJ</div>
    </footer>
    <ViewTracker websiteId={umamiWebsiteId} />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
